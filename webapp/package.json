    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "mattermost-redux": "^5.33.1",
    "moment-timezone": "^0.5.43",
