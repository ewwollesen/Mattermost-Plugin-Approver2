{
  "name": "mattermost-plugin-approver2-webapp",
  "version": "3.0.0",
  "description": "Webapp for Mattermost Approval Workflow Plugin",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
